<?xml version="1.0" encoding="utf-8"?>
<!-- 应用内更新 APK 的下载目录（AppUpdate.downloadApk 写到 getExternalFilesDir/update，
     外部存储不可用时回退内部 files/update，两处都要声明） -->
<paths>
    <external-files-path
        name="update_external"
        path="update/" />
    <files-path
        name="update_internal"
        path="update/" />
</paths>
